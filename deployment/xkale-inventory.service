[Unit]
Description=Xkale Inventory FastAPI Backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=xkale
Group=xkale
WorkingDirectory=/opt/xkale-inventory/backend
Environment="PATH=/opt/xkale-inventory/backend/venv/bin"
# DATABASE_URL y SECRET_KEY se leen de backend/.env (load_dotenv en la app)
ExecStart=/opt/xkale-inventory/backend/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --root-path /api \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
